# Normalisasi akhir baris
* text=auto eol=lf
*.svg text eol=lf

# ---- GitHub Linguist (bilah bahasa repositori) ----
# TypeScript adalah JavaScript bertipe (dikompilasi menjadi JavaScript),
# sehingga dihitung sebagai JavaScript.
*.ts  linguist-language=JavaScript
*.tsx linguist-language=JavaScript

# File hasil generate tidak dihitung.
src/content/questionBank.ts linguist-generated=true
supabase/setup_all.sql      linguist-generated=true
package-lock.json           linguist-generated=true

# SQL (skema database) & CSS (gaya tampilan) tidak ditampilkan di bilah bahasa;
# bahasa yang ditampilkan: Python & JavaScript.
*.sql linguist-detectable=false
*.css linguist-detectable=false
