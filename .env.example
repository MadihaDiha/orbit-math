# ORBIT MATH — salin file ini menjadi .env.local lalu isi nilainya.
# Ambil dari Supabase Dashboard > Project Settings > API.

# URL proyek Supabase, contoh: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik "anon" (atau "publishable key"). AMAN untuk frontend karena dilindungi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat website (dipakai untuk tautan verifikasi email & reset password).
# Lokal: http://localhost:3000  |  Produksi: https://nama-proyek.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di sini atau di frontend.

# ---------------------------------------------------------------------------
# BIMO AI (chatbot DeepSeek) — RAHASIA, khusus server.
# PENTING: JANGAN beri awalan NEXT_PUBLIC_ (awalan itu membuat nilai ikut ke browser).
# Dapatkan API key di https://platform.deepseek.com/api_keys
# Isi di .env.local (lokal) atau Environment Variables Vercel — jangan di-commit ke GitHub.
DEEPSEEK_API_KEY=
# Model DeepSeek (opsional). Default: deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Backend BIMO AI yang dipanggil browser:
#   next     = route /api/bimo-chat milik aplikasi ini (default; npm run dev / Vercel)
#   supabase = Supabase Edge Function "bimo-chat" (API key disimpan di Supabase Secrets)
NEXT_PUBLIC_BIMO_AI_BACKEND=next
