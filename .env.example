# ORBIT MATH — salin file ini menjadi .env.local lalu isi nilainya.
# Ambil dari Supabase Dashboard > Project Settings > API.

# URL proyek Supabase, contoh: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik "anon" (atau "publishable key"). AMAN untuk frontend karena dilindungi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat website (dipakai untuk tautan verifikasi email & reset password).
# Lokal: http://localhost:3000  |  Produksi: https://nama-proyek.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JANGAN PERNAH menaruh SUPABASE_SERVICE_ROLE_KEY di sini atau di frontend.
